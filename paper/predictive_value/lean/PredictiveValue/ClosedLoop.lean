import Mathlib
import PredictiveValue.Information

/-!
# Closed loop: steering has no information envelope (Proposition `prop:clsteer`)

Paper: `sigmetrics.tex` lines 792-812 (`prop:clsteer`, Section `sec:closedloop`).

The process: `X_0` a fair bit, `X_{t+1} = X_t ⊕ w_t`, reward `R_t = 1[X_t = 1]`
(oscillation `Ω = 1`, independent of the action), delay `D = 1`.
Expectations over the fair bit `X_0` are the average over `X_0 ∈ Bool`.

A policy is represented by the action sequence it produces for each value of `X_0`,
`a : Bool → ℕ → Bool`. Open-loop policies are those with `a` constant in `X_0`.
The delayed-feedback policies of the paper are generated by `clTraj`, which feeds the
step-`t` rule only `(X_{t-1}, w_{t-1})`; the optimality bound `value_le` is proved for
the much larger class of *all* policies whose first action does not depend on `X_0`
(the rule may use anything, including all past actions and the full state history).

For the envelope, `G_t` is represented by the pair `(X_{t-1}, w_{t-1})` (`G_0` trivial).
Under the feedback policy this pair is sufficient: `w_0` is the constant `false`, and for
`t ≥ 2` every earlier action is a function of `X_0`, which is itself recovered from
`(X_1, w_1)`; in any case `X_t` is constant for `t ≥ 2`, so `I(X_t; G_t) = 0` for
every representation of `G_t`.
-/

open Finset Real

namespace PredictiveValue.ClosedLoop

/-- State trajectory `X_t` driven by the action sequence `w` from `X_0 = x0`. -/
def state (w : ℕ → Bool) (x0 : Bool) : ℕ → Bool
  | 0 => x0
  | t + 1 => Bool.xor (state w x0 t) (w t)

/-- Step reward `R_t(w, x) = 1[x = 1]` (does not depend on the action). -/
noncomputable def rew (x : Bool) : ℝ := if x then 1 else 0

/-- Total reward over steps `0..T-1`. -/
noncomputable def total (w : ℕ → Bool) (x0 : Bool) (T : ℕ) : ℝ :=
  ∑ t ∈ range T, rew (state w x0 t)

/-- Expected total reward of a policy (action sequence as a function of `X_0`),
`X_0` a fair bit. -/
noncomputable def value (a : Bool → ℕ → Bool) (T : ℕ) : ℝ :=
  (total (a false) false T + total (a true) true T) / 2

theorem rew_add_not (x : Bool) : rew x + rew (!x) = 1 := by
  cases x <;> simp [rew]

theorem rew_le_one (x : Bool) : rew x ≤ 1 := by
  cases x <;> simp [rew]

theorem state_not (w : ℕ → Bool) (x0 : Bool) (t : ℕ) :
    state w (!x0) t = !(state w x0 t) := by
  induction t with
  | zero => rfl
  | succ t ih =>
    simp only [state, ih]
    cases state w x0 t <;> cases w t <;> rfl

/-- **Part 1 (open loop).** Every open-loop action sequence earns expected total `T/2`. -/
theorem openLoop_value (w : ℕ → Bool) (T : ℕ) : value (fun _ => w) T = (T : ℝ) / 2 := by
  unfold value total
  have h : ∀ t, rew (state w true t) = 1 - rew (state w false t) := by
    intro t
    have := rew_add_not (state w false t)
    rw [show true = !false from rfl, state_not]
    linarith
  simp only [h, Finset.sum_sub_distrib, Finset.sum_const, card_range, nsmul_eq_mul, mul_one]
  ring

/-! ## Delayed-feedback policies -/

/-- Closed-loop trajectory `(X_t, w_t)` of the policy with first action `w0` and rule
`rule t X_{t-1} w_{t-1}` for `t ≥ 1` (delay `D = 1`: the step-`t` action sees only
`X_{t-1}` and the previous action). -/
def clTraj (w0 : Bool) (rule : ℕ → Bool → Bool → Bool) (x0 : Bool) : ℕ → Bool × Bool
  | 0 => (x0, w0)
  | t + 1 =>
    (Bool.xor (clTraj w0 rule x0 t).1 (clTraj w0 rule x0 t).2,
      rule (t + 1) (clTraj w0 rule x0 t).1 (clTraj w0 rule x0 t).2)

/-- Action sequence produced by a closed-loop policy. -/
def clActs (w0 : Bool) (rule : ℕ → Bool → Bool → Bool) (x0 : Bool) (t : ℕ) : Bool :=
  (clTraj w0 rule x0 t).2

theorem clTraj_state (w0 : Bool) (rule : ℕ → Bool → Bool → Bool) (x0 : Bool) (t : ℕ) :
    state (clActs w0 rule x0) x0 t = (clTraj w0 rule x0 t).1 := by
  induction t with
  | zero => rfl
  | succ t ih => simp only [state, ih, clActs, clTraj]

/-- The feedback rule of the proof: `w_1 = 1 ⊕ X_1` with `X_1 = X_0 ⊕ w_0` computed from
`G_1 = (X_0, w_0)`, and `w_t = 0` for `t ≥ 2`. -/
def fbRule (t : ℕ) (xprev wprev : Bool) : Bool :=
  if t = 1 then !(Bool.xor xprev wprev) else false

/-- The feedback policy (`w_0 = 0`). -/
def fbTraj (x0 : Bool) : ℕ → Bool × Bool := clTraj false fbRule x0

theorem fbTraj_zero (x0 : Bool) : fbTraj x0 0 = (x0, false) := rfl

theorem fbTraj_one (x0 : Bool) : fbTraj x0 1 = (x0, !x0) := by
  simp [fbTraj, clTraj, fbRule]

theorem fbTraj_ge2 (x0 : Bool) (n : ℕ) : fbTraj x0 (n + 2) = (true, false) := by
  induction n with
  | zero =>
    show clTraj false fbRule x0 2 = (true, false)
    simp only [clTraj, fbRule]
    cases x0 <;> rfl
  | succ n ih =>
    have h : clTraj false fbRule x0 (n + 2) = (true, false) := ih
    have e : clTraj false fbRule x0 (n + 2 + 1) =
        (Bool.xor (clTraj false fbRule x0 (n + 2)).1 (clTraj false fbRule x0 (n + 2)).2,
          fbRule (n + 2 + 1) (clTraj false fbRule x0 (n + 2)).1
            (clTraj false fbRule x0 (n + 2)).2) := rfl
    show clTraj false fbRule x0 (n + 2 + 1) = (true, false)
    rw [e, h]
    simp [fbRule]

/-- **Part 2 (feedback value).** The feedback policy earns expected total `T - 1`. -/
theorem feedback_value (T : ℕ) (hT : 2 ≤ T) :
    value (clActs false fbRule) T = (T : ℝ) - 1 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hT
  unfold value total
  simp only [clTraj_state]
  have h : ∀ x0, ∑ t ∈ range (n + 2), rew (clTraj false fbRule x0 t).1 = n + 2 * rew x0 := by
    intro x0
    rw [Finset.sum_range_succ', Finset.sum_range_succ']
    have h0 : (clTraj false fbRule x0 0).1 = x0 := rfl
    have h1 : (clTraj false fbRule x0 1).1 = x0 := by simp [clTraj]
    have h2 : ∀ i, (clTraj false fbRule x0 (i + 1 + 1)).1 = true := by
      intro i; have := fbTraj_ge2 x0 i; simp only [fbTraj] at this; rw [this]
    simp only [h0, h1, h2]
    cases x0 <;> norm_num [rew]
    ring
  rw [h, h]
  simp [rew]; ring

/-- **Part 2 (optimality, general form).** Every policy whose first action does not
depend on `X_0` (later actions may depend on anything) earns at most `T - 1`. -/
theorem value_le (a : Bool → ℕ → Bool) (ha : a false 0 = a true 0) (T : ℕ) (hT : 2 ≤ T) :
    value a T ≤ (T : ℝ) - 1 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hT
  unfold value total
  have hb : ∀ x0, ∑ t ∈ range (n + 2), rew (state (a x0) x0 t)
      ≤ n + (rew (Bool.xor x0 (a x0 0)) + rew x0) := by
    intro x0
    rw [Finset.sum_range_succ', Finset.sum_range_succ']
    have hs : ∑ i ∈ range n, rew (state (a x0) x0 (i + 1 + 1)) ≤ ∑ _i ∈ range n, (1 : ℝ) :=
      Finset.sum_le_sum (fun i _ => rew_le_one _)
    simp only [Finset.sum_const, card_range, nsmul_eq_mul, mul_one] at hs
    simp only [state] at *
    linarith
  have h1 := hb false
  have h2 := hb true
  rw [← ha] at h2
  have e : rew (Bool.xor false (a false 0)) + rew false
      + (rew (Bool.xor true (a false 0)) + rew true) = 2 := by
    cases a false 0 <;> simp [rew] <;> norm_num
  push_cast
  linarith

/-- Optimality restricted to the delayed-feedback class `clTraj`. -/
theorem feedback_optimal (w0 : Bool) (rule : ℕ → Bool → Bool → Bool) (T : ℕ) (hT : 2 ≤ T) :
    value (clActs w0 rule) T ≤ value (clActs false fbRule) T := by
  rw [feedback_value T hT]
  exact value_le _ rfl T hT

/-- **Part 3 (gain).** Feedback beats every open-loop policy by `(T-2)/2`. -/
theorem steering_gain (w : ℕ → Bool) (T : ℕ) (hT : 2 ≤ T) :
    value (clActs false fbRule) T - value (fun _ => w) T = ((T : ℝ) - 2) / 2 := by
  rw [feedback_value T hT, openLoop_value]; ring

/-! ## Part 4: zero per-step decision value -/

/-- For any distribution `μ` of `X_t`, the best and worst action give equal expected
step reward (the step reward does not depend on the action). -/
theorem step_best_eq_worst (μ : Bool → ℝ) :
    (⨆ w : Bool, ∑ x, μ x * (fun (_ : Bool) x => rew x) w x)
      = ⨅ w : Bool, ∑ x, μ x * (fun (_ : Bool) x => rew x) w x := by
  simp only [ciSup_const, ciInf_const]

/-- `Δ^π_t = 0` for every joint law of `(X_t, G_t)`: the best `G_t`-measurable action
gains nothing over the best constant action (using the project's `gain2`). -/
theorem step_gain_zero {β : Type*} [Fintype β] (q : Bool → β → ℝ) :
    gain2 (fun _ x => rew x) q = 0 := by
  unfold gain2
  simp only [max_self]
  rw [Finset.sum_comm]
  simp only [Finset.mul_sum, sub_self]

/-! ## Part 5: the per-step envelopes under the feedback policy -/

/-- Joint law of `(X, G)` when both are functions of the fair bit `X_0`. -/
noncomputable def jointOf {α β : Type*} [DecidableEq α] [DecidableEq β]
    (X : Bool → α) (G : Bool → β) (a : α) (b : β) : ℝ :=
  ∑ x0 : Bool, if X x0 = a ∧ G x0 = b then 1 / 2 else 0

/-- Mutual information vanishes when `X` is a.s. constant and the joint has mass one. -/
theorem mutualInfo_const {α β : Type*} [Fintype α] [Fintype β] [DecidableEq α]
    (q : α → β → ℝ) (a0 : α) (h0 : ∀ a b, a ≠ a0 → q a b = 0) (h1 : ∑ b, q a0 b = 1) :
    mutualInfo q = 0 := by
  unfold mutualInfo ent
  have hX : ∑ a, negMulLog (∑ b, q a b) = negMulLog (∑ b, q a0 b) := by
    rw [Finset.sum_eq_single a0]
    · intro a _ ha; simp [h0 a _ ha]
    · simp
  have hG : ∀ b, ∑ a, q a b = q a0 b := by
    intro b
    rw [Finset.sum_eq_single a0]
    · intro a _ ha; exact h0 a b ha
    · simp
  have hJ : ∑ ab : α × β, negMulLog (q ab.1 ab.2) = ∑ b, negMulLog (q a0 b) := by
    rw [Fintype.sum_prod_type, Finset.sum_eq_single a0]
    · intro a _ ha; simp [h0 a _ ha]
    · simp
  rw [hX, h1, hJ]
  simp only [hG, negMulLog_one]
  ring

theorem jointOf_mass {α β : Type*} [Fintype β] [DecidableEq α] [DecidableEq β]
    (X : Bool → α) (G : Bool → β) (a0 : α) (hX : ∀ x0, X x0 = a0) :
    ∑ b, jointOf X G a0 b = 1 := by
  unfold jointOf
  rw [Finset.sum_comm]
  simp only [hX, true_and, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  simp

/-- Joint of `(X_t, G_t)` under the feedback policy for `t ≥ 1`, with
`G_t = (X_{t-1}, w_{t-1})`; `jointFb s` is the joint at `t = s + 1`. -/
noncomputable def jointFb (s : ℕ) : Bool → Bool × Bool → ℝ :=
  jointOf (fun x0 => (fbTraj x0 (s + 1)).1) (fun x0 => fbTraj x0 s)

/-- Joint of `(X_0, G_0)` with `G_0` trivial. -/
noncomputable def joint0 : Bool → Unit → ℝ := jointOf (fun x0 => x0) (fun _ => ())

/-- `I(X_0; G_0) = 0` (`G_0` trivial). -/
theorem mi_step0 : mutualInfo joint0 = 0 := by
  simp only [mutualInfo, ent, joint0, jointOf, Fintype.sum_prod_type, Fintype.sum_bool,
    Fintype.univ_ofSubsingleton, Finset.sum_singleton]
  simp
  rw [show (2 : ℝ)⁻¹ + 2⁻¹ = 1 by norm_num]
  simp

/-- `I(X_1; G_1) = log 2`: `X_1` is a fair bit determined by `G_1 = (X_0, w_0)`. -/
theorem mi_step1 : mutualInfo (jointFb 0) = log 2 := by
  have e : jointFb 0 = jointOf (fun x0 => x0) (fun x0 => (x0, false)) := by
    funext a b
    simp only [jointFb, jointOf, Fintype.sum_bool]
    rfl
  rw [e]
  simp only [mutualInfo, ent, jointOf, Fintype.sum_prod_type, Fintype.sum_bool]
  simp
  rw [← one_div, negMulLog_half]
  ring

/-- `I(X_t; G_t) = 0` for `t ≥ 2`: `X_t = 1` is constant. -/
theorem mi_step_ge2 (n : ℕ) : mutualInfo (jointFb (n + 1)) = 0 := by
  have hX : ∀ x0, (fbTraj x0 (n + 1 + 1)).1 = true := fun x0 => by rw [fbTraj_ge2]
  apply mutualInfo_const _ true
  · intro a b ha
    unfold jointFb jointOf
    simp [hX, Ne.symm ha]
  · exact jointOf_mass _ _ true hX

/-- `I^π(X_t; G_t)` under the feedback policy, step by step. -/
noncomputable def envI (t : ℕ) : ℝ :=
  match t with
  | 0 => mutualInfo joint0
  | s + 1 => mutualInfo (jointFb s)

/-- **Part 5 (envelope sum).** With `Ω = 1`, the per-step envelopes
`Ω √(I^π(X_t;G_t)/2)` over `t = 0..T-1` sum to `√(ln 2 / 2)`. -/
theorem envelope_sum (T : ℕ) (hT : 2 ≤ T) :
    ∑ t ∈ range T, 1 * sqrt (envI t / 2) = sqrt (log 2 / 2) := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hT
  rw [Finset.sum_range_succ', Finset.sum_range_succ']
  simp only [envI, mi_step0, mi_step1, mi_step_ge2, zero_div, sqrt_zero, mul_zero,
    Finset.sum_const_zero, one_mul, zero_add, add_zero]

/-- **Proposition `prop:clsteer`**, assembled. -/
theorem steering_no_envelope (T : ℕ) (hT : 2 ≤ T) :
    (∀ w : ℕ → Bool, value (fun _ => w) T = (T : ℝ) / 2) ∧
    value (clActs false fbRule) T = (T : ℝ) - 1 ∧
    (∀ a : Bool → ℕ → Bool, a false 0 = a true 0 → value a T ≤ (T : ℝ) - 1) ∧
    (∀ w : ℕ → Bool,
      value (clActs false fbRule) T - value (fun _ => w) T = ((T : ℝ) - 2) / 2) ∧
    (∀ {β : Type} [Fintype β] (q : Bool → β → ℝ), gain2 (fun _ x => rew x) q = 0) ∧
    ∑ t ∈ range T, 1 * sqrt (envI t / 2) = sqrt (log 2 / 2) :=
  ⟨fun w => openLoop_value w T, feedback_value T hT, fun a ha => value_le a ha T hT,
    fun w => steering_gain w T hT, fun q => step_gain_zero q, envelope_sum T hT⟩

end PredictiveValue.ClosedLoop
